---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import PageBanner from './PageBanner.astro';
import Footer from './Footer.astro';
import type { Lang } from '../site.config';

interface Props {
  lang: Lang;
  /** Kunci tautan navbar yang aktif. */
  current: string;
  title: string;
  lead?: string;
  /** Posisi poster pada banner pixel. */
  banner?: string;
  /** Dua kolom: judul di kiri, isi di kanan. */
  split?: boolean;
}
const { lang, current, title, lead, banner = '50% 50%', split = false } = Astro.props;
---
<BaseLayout lang={lang} title={title}>
  <Navbar lang={lang} current={current} />
  <main id="content" class="container page-top page">
    <PageBanner position={banner} />
    <div class:list={[split && 'page-split']}>
      <header class="page-head">
        <h1>{title}</h1>
        {lead && <p class="page-lead">{lead}</p>}
      </header>
      <div class="page-body"><slot /></div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style is:global>
  .page { padding-bottom: var(--space-8); }
  .page-head { margin-bottom: var(--space-6); }
  .page-head h1 { font-size: var(--text-title); }
  .page-lead { margin-top: var(--space-4); max-width: var(--measure); color: var(--text-muted); font-size: var(--text-lead); }
  .page-lead .badge { vertical-align: middle; }
  .page-split { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 56rem) { .page-split { grid-template-columns: 1fr 1fr; } .page-split .page-head { margin-bottom: 0; } }
  .card-grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .card h2, .card h3 { font-size: var(--text-lead); }
  .card p { color: var(--text-muted); }
</style>
