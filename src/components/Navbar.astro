---
import { Menu, X, FlaskConical, Folder, Users, BookOpen, Mail } from '@lucide/astro';
import { siteConfig, type Lang } from '../site.config';
import { useTranslations } from '../i18n/utils';
import { getSite } from '../i18n/content';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  /** Kunci halaman aktif, mis. 'research'. */
  current?: string;
  /** Styleguide: semua tautan aktif tanpa pindah halaman, penanda bergeser saat diklik. */
  demo?: boolean;
  /** Styleguide: tidak fixed. */
  inline?: boolean;
  /** Pembeda id bila ada lebih dari satu navbar di halaman. */
  uid?: string;
  /** Varian kaca awal. Navbar nyata beralih otomatis saat keluar dari panggung wallpaper. */
  glass?: 'theme' | 'media';
}
const { lang, current, demo = false, inline = false, uid = 'main', glass = 'theme' } = Astro.props;
const t = useTranslations(lang);
const site = await getSite(lang);
const navLabels = { projects: site.navProjects, research: site.navResearch, publications: site.navPublications, people: site.navPeople, contact: site.navContact };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icons = { research: FlaskConical, projects: Folder, people: Users, publications: BookOpen, contact: Mail };
const items = siteConfig.nav.map((key) => ({
  key,
  href: demo ? '#' : `${base}/${lang}/${key}/`,
  label: navLabels[key],
  Icon: icons[key],
}));
const menuId = `mobile-menu-${uid}`;
---
<header class:list={['navbar', inline && 'navbar--inline']} data-navbar data-base={base} data-glass={glass} data-static={inline ? '' : undefined} transition:persist={inline ? undefined : `navbar-${lang}`}>
  <div class="container navbar__grid">
    <a class="capsule glass brand" href={`${base}/${lang}/`} aria-label={siteConfig.logo.alt}>
      <span class="brand__mark" aria-hidden="true" style={`--mark: url(${base}/${siteConfig.logo.mark})`}></span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="capsule glass nav-links" aria-label={t('nav.main')} data-nav data-demo={demo ? '' : undefined}>
      <span class="nav-indicator" aria-hidden="true"></span>
      {items.map((item) => (
        <a class="nav-link" href={item.href} data-key={item.key} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="capsule glass nav-tools">
      <ThemeToggle lang={lang} />
      <LangSwitch lang={lang} demo={demo} />
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls={menuId}
        aria-label={t('nav.menu')}
        data-menu-btn
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.menu.close')}
      >
        <Menu class="menu-btn__open" size={20} aria-hidden="true" />
        <X class="menu-btn__close" size={20} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="container">
    <div id={menuId} class="mobile-menu glass" hidden>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} data-key={item.key} aria-current={current === item.key ? 'page' : undefined}><item.Icon size={20} aria-hidden="true" />{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<style is:global>
  .navbar { position: fixed; inset: 0 0 auto 0; z-index: 50; padding-block: var(--space-3); pointer-events: none; }
  .navbar--inline { position: relative; inset: auto; }
  .navbar__grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-3); }
  .capsule { pointer-events: auto; height: var(--capsule-h); border-radius: var(--radius-pill); display: flex; align-items: center; }

  .brand { justify-self: start; gap: var(--space-2); padding: 0 var(--space-5); color: var(--text); text-decoration: none; }
  .brand__mark {
    flex: none; width: 1.5rem; height: 1.5rem; background-color: var(--accent);
    -webkit-mask: var(--mark) no-repeat center / contain; mask: var(--mark) no-repeat center / contain;
    transition: background-color 320ms var(--ease);
  }
  .brand__name { font-weight: 700; letter-spacing: 0.12em; line-height: 1; }

  .nav-links { position: relative; padding: 4px; gap: 2px; }
  .nav-link {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: var(--space-2);
    height: var(--tap); padding: 0 var(--space-4); border-radius: var(--radius-pill);
    color: var(--text); text-decoration: none; font-size: 0.95rem; font-weight: 500; white-space: nowrap;
    transition: background-color 200ms var(--ease), color 200ms var(--ease);
  }
  a.nav-link:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
  a.nav-link[aria-current='page'] { color: var(--accent); font-weight: 600; }

  .nav-indicator {
    position: absolute; top: 4px; bottom: 4px; left: 0; width: var(--ind-w, 0px);
    transform: translateX(var(--ind-x, 0px)); opacity: var(--ind-o, 0);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 38%, transparent);
  }
  /* Tanpa JavaScript penanda geser tidak ada, halaman aktif diberi latar sendiri. */
  .nav-links:not(.is-ready) a.nav-link[aria-current='page'] { background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .nav-links.is-ready .nav-indicator { transition: transform 350ms var(--ease), width 350ms var(--ease), opacity 200ms var(--ease); }

  .nav-tools { justify-self: end; gap: var(--space-1); padding: 4px; }
  .menu-btn {
    display: none; flex: none; width: var(--tap); height: var(--tap); padding: 0; place-items: center;
    border-radius: 50%; border: 1px solid transparent; background: transparent; color: var(--text); cursor: pointer;
    transition: color 320ms var(--ease), background-color 200ms var(--ease);
  }
  .menu-btn:hover { background: color-mix(in srgb, var(--text) 10%, transparent); }
  .menu-btn__close { display: none; }
  .menu-btn[aria-expanded='true'] .menu-btn__open { display: none; }
  .menu-btn[aria-expanded='true'] .menu-btn__close { display: block; }

  .mobile-menu { margin-top: var(--space-2); border-radius: var(--radius-card); padding: var(--space-2); pointer-events: auto; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu li a {
    display: flex; align-items: center; gap: var(--space-3); min-height: 3rem; padding: 0 var(--space-4);
    border-radius: var(--radius-sm); color: var(--text); text-decoration: none; font-weight: 500;
  }
  .mobile-menu li a:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
  .mobile-menu li a[aria-current='page'] { color: var(--accent); }

  @media (max-width: 68.75rem) {
    .navbar__grid { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
    .menu-btn { display: inline-grid; }
  }
  @media (min-width: 68.8rem) { .mobile-menu { display: none; } }
  @media (max-width: 30rem) {
    .brand { padding: 0 var(--space-4); }
    .nav-tools .lang-switch { width: 5.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-links.is-ready .nav-indicator, .nav-link { transition: none; }
  }
</style>

<script>
  // Navbar persisten selama navigasi: aria-current, tautan bahasa, penanda geser, dan varian kaca
  // diperbarui di setiap halaman, tanpa membangun ulang elemennya.
  type Bar = HTMLElement & { _io?: IntersectionObserver; _close?: () => void };

  const segmentsOf = (base: string) => {
    const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
    return path.split('/').filter(Boolean);
  };

  const syncCurrent = (bar: Bar) => {
    const base = bar.dataset.base ?? '';
    const [, key] = segmentsOf(base);
    bar.querySelectorAll<HTMLElement>('a[data-key]').forEach((a) => {
      if (a.dataset.key === key) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    const rest = segmentsOf(base).slice(1).join('/');
    bar.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => {
      a.href = `${base}/${a.dataset.lang}/${rest ? `${rest}/` : ''}`;
    });
  };

  const setupGlass = (bar: Bar) => {
    bar._io?.disconnect();
    const stage = document.querySelector('[data-stage]');
    if (!stage) { bar.dataset.glass = 'theme'; return; }
    // Hanya pita setinggi navbar di tepi atas layar yang dihitung.
    const band = Math.max(0, window.innerHeight - bar.offsetHeight);
    bar._io = new IntersectionObserver(
      ([entry]) => { bar.dataset.glass = entry.isIntersecting ? 'media' : 'theme'; },
      { rootMargin: `0px 0px -${band}px 0px` },
    );
    bar._io.observe(stage);
  };

  const initBar = (bar: Bar) => {
    const nav = bar.querySelector<HTMLElement>('[data-nav]');
    if (!nav) return;
    const demo = nav.hasAttribute('data-demo');
    const active = () => nav.querySelector<HTMLElement>('a[aria-current="page"]');
    const place = (el: HTMLElement | null) => {
      if (!el) { nav.style.setProperty('--ind-o', '0'); return; }
      nav.style.setProperty('--ind-x', `${el.offsetLeft}px`);
      nav.style.setProperty('--ind-w', `${el.offsetWidth}px`);
      nav.style.setProperty('--ind-o', '1');
    };

    if (!bar.dataset.bound) {
      bar.dataset.bound = '';
      window.addEventListener('resize', () => place(active()));
      document.fonts?.ready.then(() => place(active()));
      if (demo) {
        nav.querySelectorAll<HTMLAnchorElement>('a.nav-link').forEach((a) =>
          a.addEventListener('click', (event) => {
            event.preventDefault();
            active()?.removeAttribute('aria-current');
            a.setAttribute('aria-current', 'page');
            place(a);
          }),
        );
      }
      const btn = bar.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const panel = btn ? document.getElementById(btn.getAttribute('aria-controls') ?? '') : null;
      if (btn && panel) {
        const setOpen = (open: boolean) => {
          panel.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
        };
        bar._close = () => setOpen(false);
        btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !panel.hidden) { setOpen(false); btn.focus(); }
        });
        panel.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) setOpen(false); });
        window.matchMedia('(min-width: 68.8rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
      }
    }

    if (!demo) syncCurrent(bar);
    bar._close?.();
    place(active());
    if (!nav.classList.contains('is-ready')) requestAnimationFrame(() => nav.classList.add('is-ready'));
    if (!bar.hasAttribute('data-static')) setupGlass(bar);
  };

  const init = () => document.querySelectorAll<Bar>('[data-navbar]').forEach(initBar);
  init();
  document.addEventListener('astro:page-load', init);
</script>
