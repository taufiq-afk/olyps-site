---
import StatusLine from '../StatusLine.astro';
import { ArrowDown, ArrowUpRight, Pause, Play } from '@lucide/astro';
import { siteConfig, type Lang } from '../../site.config';
import { useTranslations } from '../../i18n/utils';
import type { UiKey } from '../../i18n/ui';
import { entrySlug } from '../../i18n/content';
import PlaceholderBadge from '../PlaceholderBadge.astro';

interface Props {
  lang: Lang;
  /** Proyek unggulan pertama (dari src/data/featured.json). Kosong bila belum ada yang tampil. */
  project?: { id: string; data: { title: string; summary: string; status: string; placeholder: boolean } };
}
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="hero" aria-labelledby="hero-title">
  <div class:list={['container hero__grid', !project && 'hero__grid--single']}>
    <div class="hero__copy">
      <p class="hero__eyebrow reveal">{siteConfig.descriptor[lang]}</p>
      <h1 id="hero-title" class="reveal">{siteConfig.tagline[lang]}</h1>
      <p class="hero__lead reveal">{t('hero.lead')}</p>
      <div class="hero__actions reveal">
        <a class="btn btn--primary" href="#explore">{t('hero.cta.explore')}<ArrowDown size={18} aria-hidden="true" /></a>
      </div>
    </div>

    {project && (
      <a class="hero__card card--lg glass reveal" data-glow href={`${base}/${lang}/projects/${entrySlug(project.id)}/`}>
        <p class="eyebrow">{t('hero.card.label')}</p>
        <div class="hero__card-head">
          <h2>{project.data.title}</h2>
          <StatusLine lang={lang} status={project.data.status} startDate={project.data.startDate} endDate={project.data.endDate} />
        </div>
        <p class="hero__card-body">{project.data.summary}{project.data.placeholder && <Fragment> <PlaceholderBadge lang={lang} /></Fragment>}</p>
        <ArrowUpRight class="hero__card-arrow" size={22} aria-hidden="true" />
      </a>
    )}
  </div>

  <button
    type="button"
    class="media-toggle glass"
    data-media-toggle
    data-state="playing"
    data-label-pause={t('media.pause')}
    data-label-play={t('media.play')}
    aria-label={t('media.pause')}
    hidden
  >
    <Pause class="i-pause" size={18} aria-hidden="true" />
    <Play class="i-play" size={18} aria-hidden="true" />
  </button>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: center;
    padding-top: calc(var(--capsule-h) + var(--stage-pad)); padding-bottom: calc(var(--stage-pad) + var(--space-5));
    color: var(--text);
  }
  .hero__grid { position: relative; z-index: 1; display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 64rem) { .hero__grid { grid-template-columns: 1.3fr 1fr; gap: var(--space-8); } .hero__grid--single { grid-template-columns: 1fr; } }

  .hero__eyebrow { font-size: var(--text-small); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-5); }
  h1 { font-size: var(--text-hero); max-width: 14ch; }
  .hero__lead { font-size: var(--text-lead); color: var(--text-muted); max-width: var(--measure); margin-top: var(--space-6); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .hero__card {
    position: relative; display: flex; flex-direction: column; gap: var(--space-4); justify-self: end; width: 100%; max-width: 34rem;
    border-radius: var(--radius-card); color: var(--text); text-decoration: none;
    transition: transform 280ms var(--ease), box-shadow 280ms var(--ease);
  }
  .hero__card:hover, .hero__card:focus-visible { transform: translateY(-4px); }
  .hero__card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .hero__card-head h2 { font-size: var(--text-lead); }
  .hero__card-body { color: var(--text-muted); }
  .hero__card :global(.hero__card-arrow) { margin-top: auto; align-self: flex-end; color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) { .hero__card, .hero__card:hover, .hero__card:focus-visible { transition: none; transform: none; } }

  .media-toggle {
    position: absolute; bottom: var(--space-5);
    right: calc((100% - min(100% - 2 * var(--gutter), var(--container-max))) / 2);
    display: grid; place-items: center; width: var(--tap); height: var(--tap); padding: 0;
    border-radius: 50%; color: var(--text); cursor: pointer;
  }
  .media-toggle[hidden] { display: none; }
  .media-toggle :global(svg) { grid-area: 1 / 1; display: none; }
  .media-toggle[data-state='playing'] :global(.i-pause), .media-toggle[data-state='paused'] :global(.i-play) { display: block; }
</style>
