---
import { BookOpen, FlaskConical, Users } from '@lucide/astro';
import { type Lang } from '../../site.config';
import { getHome } from '../../i18n/content';
import Widget from '../Widget.astro';

interface Props {
  lang: Lang;
  /** Jumlah entri yang tampil di Home (placeholder sudah disaring pada build produksi). */
  counts: { research: number; publications: number; people: number };
}
const { lang, counts } = Astro.props;
const home = await getHome(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = (key: string) => `${base}/${lang}/${key}/`;
// Jumlah entri, atau keadaan kosong bila belum ada.
const body = (kind: 'research' | 'publications' | 'people') => {
  const n = counts[kind];
  if (n === 0) return home.exploreEmpty;
  const text = { research: [home.exploreResearchOne, home.exploreResearchOther], publications: [home.explorePublicationsOne, home.explorePublicationsOther], people: [home.explorePeopleOne, home.explorePeopleOther] }[kind];
  return text[n === 1 ? 0 : 1].replace('{n}', String(n));
};
---
<section class="explore" aria-labelledby="explore">
  <div class="container explore__inner">
    <h2 id="explore" class="reveal">{home.exploreTitle}</h2>
    <div class="explore__widgets">
      <div class="reveal" data-reveal="left" style="--i:0"><Widget icon={FlaskConical} title={home.exploreResearchTitle} body={body('research')} href={to('research')} /></div>
      <div class="reveal" style="--i:1"><Widget icon={BookOpen} title={home.explorePublicationsTitle} body={body('publications')} href={to('publications')} /></div>
      <div class="reveal" data-reveal="right" style="--i:2"><Widget icon={Users} title={home.explorePeopleTitle} body={body('people')} href={to('people')} /></div>
    </div>
  </div>
</section>

<style>
  .explore { padding-top: var(--stage-pad); color: var(--text); }
  /* Tautan #explore: judul tidak boleh tertutup navbar. */
  h2 { font-size: var(--text-title); margin-bottom: var(--space-7); scroll-margin-top: calc(var(--capsule-h) + var(--space-6)); }
  .explore__widgets { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .explore__widgets > div { display: flex; }
  .explore__widgets :global(.widget) { flex: 1; }
</style>
