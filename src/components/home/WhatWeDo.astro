---
import { Folder } from '@lucide/astro';
import StatusLine from '../StatusLine.astro';
import Card from '../Card.astro';
import type { Lang } from '../../site.config';
import { entrySlug, getHome } from '../../i18n/content';
import PlaceholderBadge from '../PlaceholderBadge.astro';

interface Props {
  lang: Lang;
  /** Proyek unggulan dari src/data/featured.json, placeholder sudah disaring pada build produksi. */
  projects: { id: string; data: { title: string; summary: string; status: string; startDate?: string; endDate?: string; placeholder: boolean } }[];
}
const { lang, projects } = Astro.props;
const home = await getHome(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="section what" aria-labelledby="what-title">
  <div class="container">
    <h2 id="what-title" class="reveal">{home.whatTitle}</h2>
    {projects.length === 0 ? (
      <p class="what__empty reveal">{home.whatEmpty}</p>
    ) : (
      <div class="entry-grid">
        {projects.map((project, i) => (
          <Card class="reveal" data-reveal={i % 2 === 0 ? 'left' : 'right'} style={`--i:${i}`} href={`${base}/${lang}/projects/${entrySlug(project.id)}/`} title={project.data.title} summary={project.data.summary}>
            <span slot="media" class="icon-tile"><Folder size={26} aria-hidden="true" /></span>
            <Fragment slot="meta">
              <StatusLine lang={lang} status={project.data.status} startDate={project.data.startDate} endDate={project.data.endDate} />
              {project.data.placeholder && <PlaceholderBadge lang={lang} />}
            </Fragment>
          </Card>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /* Keadaan kosong ringkas: satu baris, tanpa kartu. */
  .what__empty { color: var(--text-muted); max-width: var(--measure); }
</style>
