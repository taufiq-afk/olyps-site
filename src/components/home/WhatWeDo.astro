---
import { ArrowUpRight, Folder } from '@lucide/astro';
import type { Lang } from '../../site.config';
import { useTranslations } from '../../i18n/utils';
import type { UiKey } from '../../i18n/ui';
import { entrySlug } from '../../i18n/content';
import PlaceholderBadge from '../PlaceholderBadge.astro';

interface Props {
  lang: Lang;
  /** Proyek unggulan dari src/data/featured.ts, placeholder sudah disaring pada build produksi. */
  projects: { id: string; data: { title: string; summary: string; status: string; placeholder: boolean } }[];
}
const { lang, projects } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="section what" aria-labelledby="what-title">
  <div class="container">
    <h2 id="what-title" class="reveal">{t('home.what.title')}</h2>
    {projects.length === 0 ? (
      <div class="card card--lg what__empty reveal"><p>{t('empty.featured')}</p></div>
    ) : (
      <div class="areas">
        {projects.map((project, i) => (
          <a class="card card--lg card--link reveal" data-glow data-reveal={i % 2 === 0 ? 'left' : 'right'} style={`--i:${i}`} href={`${base}/${lang}/projects/${entrySlug(project.id)}/`}>
            <span class="icon-tile"><Folder size={26} aria-hidden="true" /></span>
            <h3>{project.data.title}</h3>
            <span class="badge badge--accent">{t(`status.${project.data.status}` as UiKey)}</span>
            <p>{project.data.summary}</p>
            {project.data.placeholder && <PlaceholderBadge lang={lang} />}
            <ArrowUpRight class="card__arrow" size={22} aria-hidden="true" />
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .areas { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .card h3 { font-size: var(--text-lead); }
  .card p { color: var(--text-muted); }
  .what__empty { max-width: 36rem; }
</style>
