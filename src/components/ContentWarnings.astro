---
// Banner kecil hanya di mode dev: relasi yang menunjuk entri yang tidak ada (dilewati, bukan crash).
// Pada build produksi komponen ini tidak merender apa pun, karena relasi putus sudah menggagalkan build.
import { getBrokenRelations, type BrokenRelation } from '../i18n/content';

interface Props { scope: string }
const { scope } = Astro.props;
const items: BrokenRelation[] = import.meta.env.DEV && ['research', 'projects', 'publications', 'people', 'home'].includes(scope)
  ? await getBrokenRelations(scope as BrokenRelation['scope'])
  : [];
---
{items.length > 0 && (
  <aside class="dev-warn" role="status" aria-live="polite">
    <strong>Dev: {items.length} relasi putus dilewati</strong>
    <ul>
      {items.map((b) => <li><code>{b.file}</code> {b.field}: <code>{b.key}</code></li>)}
    </ul>
    <p>Di build produksi ini menjadi kesalahan. Hapus kuncinya dari berkas itu.</p>
  </aside>
)}

<style is:global>
  .dev-warn { position: fixed; z-index: 200; left: 0.75rem; bottom: 0.75rem; max-width: min(28rem, calc(100vw - 1.5rem)); padding: 0.6rem 0.8rem; border-radius: 12px; font-size: 0.8125rem; line-height: 1.4; background: #fff4d6; color: #3d2d00; border: 1px solid #d9b44a; box-shadow: 0 6px 20px rgb(0 0 0 / 0.2); }
  .dev-warn ul { margin: 0.3rem 0; padding-left: 1.1rem; }
  .dev-warn p { margin: 0; }
  .dev-warn code { font-size: 0.75rem; word-break: break-all; }
</style>
