---
import { siteLangs, type Lang } from '../site.config';
import { switchLangPath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Untuk halaman styleguide: penanda bergeser tanpa pindah halaman. */
  demo?: boolean;
}
const { lang, demo = false } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---
<nav class="lang-switch" aria-label={t('lang.switch')} data-lang-switch data-active={lang} data-demo={demo ? '' : undefined}>
  <span class="lang-switch__thumb" aria-hidden="true"></span>
  {siteLangs.map((target) => (
    <a
      href={demo ? '#' : switchLangPath(Astro.url.pathname, base, target)}
      hreflang={target}
      lang={target}
      data-lang={target}
      aria-current={target === lang ? 'true' : undefined}
    >{target.toUpperCase()}</a>
  ))}
</nav>

<style is:global>
  .lang-switch {
    position: relative; flex: none; width: 6.5rem; height: var(--tap);
    display: grid; grid-template-columns: 1fr 1fr; align-items: stretch;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--text) 7%, transparent);
    border: 1px solid var(--border);
  }
  .lang-switch a {
    position: relative; z-index: 1; display: grid; place-items: center;
    font-size: var(--text-small); font-weight: 600; letter-spacing: 0.04em;
    color: var(--text-muted); text-decoration: none; border-radius: var(--radius-pill);
    transition: color 200ms var(--ease);
  }
  .lang-switch a[aria-current='true'] { color: var(--on-accent); }
  .lang-switch__thumb {
    position: absolute; top: 2px; bottom: 2px; left: 2px; width: calc(50% - 2px);
    border-radius: var(--radius-pill); background: var(--accent); box-shadow: var(--shadow-sm);
    transition: transform 280ms var(--ease);
  }
  .lang-switch[data-active='id'] .lang-switch__thumb { transform: translateX(100%); }
  .lang-switch:has(a[data-lang='id']:hover) a[data-lang='id'] { color: var(--text); }
  @media (prefers-reduced-motion: reduce) {
    .lang-switch__thumb, .lang-switch a { transition: none; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  // Penanda bergeser dulu, lalu pindah halaman. Dengan reduced motion langsung pindah.
  const init = () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((nav) => {
      nav.querySelectorAll<HTMLAnchorElement>('a[data-lang]:not([data-bound])').forEach((a) => {
        a.dataset.bound = '';
        a.addEventListener('click', (event) => {
          const target = a.dataset.lang ?? '';
          const demo = nav.hasAttribute('data-demo');
          if (target === nav.dataset.active) { if (demo) event.preventDefault(); return; }
          if (demo) {
            event.preventDefault();
            nav.dataset.active = target;
            nav.querySelectorAll('a').forEach((x) => (x === a ? x.setAttribute('aria-current', 'true') : x.removeAttribute('aria-current')));
            return;
          }
          if (reduce || event.metaKey || event.ctrlKey || event.shiftKey) return;
          event.preventDefault();
          nav.dataset.active = target;
          window.setTimeout(() => { navigate(a.href); }, 220);
        });
      });
    });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
