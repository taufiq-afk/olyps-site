---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLang, siteLangs } from '../site.config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout lang={defaultLang} title="OLYPS">
  <meta slot="head" http-equiv="refresh" content={`1; url=${base}/${defaultLang}/`} />
  <main>
    <p>
      {siteLangs.map((l, i) => (<>{i > 0 && ' / '}<a href={`${base}/${l}/`}>{l.toUpperCase()}</a></>))}
    </p>
  </main>
  <script is:inline define:vars={{ base, langs: siteLangs, fallback: defaultLang }}>
    // Pilih bahasa dari preferensi browser, fallback ke bahasa utama.
    var prefs = navigator.languages || [navigator.language || fallback];
    var pick = fallback;
    for (var i = 0; i < prefs.length; i++) {
      var code = String(prefs[i]).toLowerCase().split('-')[0];
      if (langs.indexOf(code) !== -1) { pick = code; break; }
    }
    location.replace(base + '/' + pick + '/');
  </script>
</BaseLayout>
