---
import { FlaskConical } from '@lucide/astro';
import PageShell from '../../../components/PageShell.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import StatusLine from '../../../components/StatusLine.astro';
import Card from '../../../components/Card.astro';
import { entrySlug, getLocalized, getPage } from '../../../i18n/content';
import { siteLangs, type Lang } from '../../../site.config';

export function getStaticPaths() {
  return siteLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getLocalized('research', lang);
const page = await getPage('research', lang);
---
<PageShell lang={lang} current="research" title={page.title} tabTitle={page.tabTitle} lead={page.lead}>
  {entries.length === 0 ? (
    <div class="card empty">{page.emptyTitle && <h2>{page.emptyTitle}</h2>}{page.emptyBody && <p>{page.emptyBody}</p>}</div>
  ) : (
    <div class="entry-grid">
      {entries.map((entry) => (
        <Card id={entrySlug(entry.id)} href={`${base}/${lang}/research/${entrySlug(entry.id)}/`} title={entry.data.title} summary={entry.data.summary}>
          <span slot="media" class="icon-tile"><FlaskConical size={26} aria-hidden="true" /></span>
          <Fragment slot="meta">
            <StatusLine lang={lang} status={entry.data.status} startDate={entry.data.startDate} endDate={entry.data.endDate} />
            {entry.data.placeholder && <PlaceholderBadge lang={lang} />}
          </Fragment>
        </Card>
      ))}
    </div>
  )}
</PageShell>

<style>
  .empty { max-width: 36rem; }
</style>
