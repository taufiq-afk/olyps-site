---
import { render } from 'astro:content';
import PageShell from '../../../components/PageShell.astro';
import DetailPage from '../../../components/DetailPage.astro';
import { entrySlug, getLocalized, getRelated } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import { siteLangs, type Lang } from '../../../site.config';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of siteLangs) {
    for (const entry of await getLocalized('research', lang)) {
      paths.push({ params: { lang, slug: entrySlug(entry.id) }, props: { entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(entry);
const all = await getRelated('research', entry.data.translationKey, lang);
// Orang yang terkait tampil sebagai penulis, sisanya sebagai item terkait.
const authors = all.filter((r) => r.kind === 'people');
const related = all.filter((r) => r.kind !== 'people');
---
<PageShell lang={lang} current="research" title={entry.data.title}>
  <DetailPage
    lang={lang}
    backHref={`${base}/${lang}/research/`}
    backLabel={t('research.back')}
    summary={entry.data.summary}
    placeholder={entry.data.placeholder}
    status={entry.data.status}
    startDate={entry.data.startDate}
    endDate={entry.data.endDate}
    leadsTo={entry.data.leadsTo}
    leadsToUrl={entry.data.leadsToUrl}
    people={authors}
    peopleLabel={t('research.by')}
    related={related}
  >
    <Content />
  </DetailPage>
</PageShell>
