---
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import PageShell from '../../../components/PageShell.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import Related from '../../../components/Related.astro';
import { entrySlug, getLocalized, getRelated } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import type { UiKey } from '../../../i18n/ui';
import { siteLangs, type Lang } from '../../../site.config';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of siteLangs) {
    for (const entry of await getLocalized('research', lang)) {
      paths.push({ params: { lang, slug: entrySlug(entry.id) }, props: { entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(entry);
const all = await getRelated('research', entry.data.translationKey, lang);
// Orang yang terkait ditampilkan sebagai penulis, sisanya sebagai bagian "Related".
const authors = all.filter((r) => r.kind === 'people');
const related = all.filter((r) => r.kind !== 'people');
---
<PageShell lang={lang} current="research" title={entry.data.title} banner="50% 14%">
  <a class="back-link" href={`${base}/${lang}/research/`}><ArrowLeft size={18} aria-hidden="true" />{t('research.back')}</a>
  <article class="detail detail--single">
    <div class="detail__meta">
      {entry.data.status && <span class="badge badge--accent">{t(`research.status.${entry.data.status}` as UiKey)}</span>}
      {entry.data.placeholder && <PlaceholderBadge lang={lang} />}
    </div>
    {authors.length > 0 && (
      <p class="detail__by">{t('research.by')} {authors.map((a, i) => <Fragment>{i > 0 && ', '}<a href={a.href}>{a.title}</a></Fragment>)}</p>
    )}
    <p class="detail__summary">{entry.data.summary}</p>
    <div class="prose"><Content /></div>
    <Related lang={lang} items={related} />
  </article>
</PageShell>

<style is:global>
  .detail--single { max-width: 52rem; }
  .detail__by { margin-bottom: var(--space-3); color: var(--text-muted); }
  .detail__by a { color: var(--accent); }
</style>
