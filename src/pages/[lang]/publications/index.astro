---
import { BookOpen, ExternalLink } from '@lucide/astro';
import PageShell from '../../../components/PageShell.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import Related from '../../../components/Related.astro';
import { entrySlug, getLocalized, getRelated } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import { siteLangs, type Lang } from '../../../site.config';

export function getStaticPaths() {
  return siteLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getLocalized('publications', lang);
const people = await getLocalized('people', lang);
const slugOf = new Map(people.map((p) => [p.data.translationKey, entrySlug(p.id)]));
const rows = await Promise.all(entries.map(async (entry) => ({
  entry,
  // Penulis anggota tim tampil sebagai tautan ke profil. Related memuat entri lain selain penulis yang sudah tertaut di baris ini.
  related: (await getRelated('publications', entry.data.translationKey, lang)).filter((r) => r.kind !== 'people'),
})));
---
<PageShell lang={lang} current="publications" title={t('nav.publications')} banner="22% 40%">
  {rows.length === 0 ? (
    <div class="card empty">
      <span class="icon-tile"><BookOpen size={26} aria-hidden="true" /></span>
      <h2>{t('pub.empty.title')}</h2>
      <p>{t('pub.empty.body')}</p>
    </div>
  ) : (
    <ol class="pubs">
      {rows.map(({ entry, related }) => (
        <li class="pub" id={entrySlug(entry.id)}>
          <h2 class="pub__title">{entry.data.title}</h2>
          <p class="pub__authors">
            {entry.data.authors.map((author, i) => (
              <Fragment>
                {i > 0 && ', '}
                {author.personKey && slugOf.get(author.personKey)
                  ? <a href={`${base}/${lang}/people/${slugOf.get(author.personKey)}/`}>{author.name}</a>
                  : <span>{author.name}</span>}
              </Fragment>
            ))}
          </p>
          <p class="pub__meta">
            <span>{entry.data.venue}</span>
            <span>{entry.data.year}</span>
            {entry.data.pages && <span>{t('pub.pages')} {entry.data.pages}</span>}
            {entry.data.doi && (
              <a class="pub__doi" href={`https://doi.org/${entry.data.doi}`} rel="noopener">
                {t('pub.doi')} {entry.data.doi}<ExternalLink size={14} aria-hidden="true" />
              </a>
            )}
            {entry.data.placeholder && <PlaceholderBadge lang={lang} />}
          </p>
          <Related lang={lang} items={related} compact />
        </li>
      ))}
    </ol>
  )}
</PageShell>

<style>
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); max-width: 36rem; padding: var(--space-7) var(--space-6); }
  .pubs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .pub { padding: var(--space-5) 0; border-bottom: 1px solid var(--border); scroll-margin-top: calc(var(--capsule-h) + var(--space-6)); }
  .pub__title { font-size: var(--text-lead); max-width: 56rem; }
  .pub__authors { margin-top: var(--space-2); color: var(--text); }
  .pub__authors a { color: var(--accent); }
  .pub__meta { margin-top: var(--space-1); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-4); color: var(--text-muted); font-size: var(--text-small); }
  .pub__doi { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--accent); min-height: 1.75rem; }
</style>
