---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import Hero from '../../components/home/Hero.astro';
import Explore from '../../components/home/Explore.astro';
import WhatWeDo from '../../components/home/WhatWeDo.astro';
import Footer from '../../components/Footer.astro';
import ContentWarnings from '../../components/ContentWarnings.astro';
import { getFeatured, getLocalized } from '../../i18n/content';
import { siteLangs, type Lang } from '../../site.config';

export function getStaticPaths() {
  return siteLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
// Daftar unggulan divalidasi di sini (lebih dari 3 atau key tidak ada menggagalkan build).
const featured = await getFeatured(lang);
const counts = {
  research: (await getLocalized('research', lang)).length,
  publications: (await getLocalized('publications', lang)).length,
  people: (await getLocalized('people', lang)).length,
};
---
<BaseLayout lang={lang}>
  <Navbar lang={lang} glass="media" />
  <ContentWarnings scope="home" lang={lang} />
  <main id="content">
    <div class="stage" data-stage data-glass="media">
      <div class="stage__media"><HeroMedia cover="[data-stage]" /></div>
      <div class="stage__content">
        <Hero lang={lang} project={featured[0]} />
        <Explore lang={lang} counts={counts} />
      </div>
    </div>
    <div class="sheet">
      <WhatWeDo lang={lang} projects={featured} />
      <Footer lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  // Animasi masuk per elemen. Tanpa JavaScript atau dengan reduced motion, semua langsung tampil.
  const initReveal = () => {
    const items = document.querySelectorAll<HTMLElement>('.reveal');
    if (!items.length) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    document.documentElement.classList.add('reveal-on');
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }),
      { threshold: 0.2 },
    );
    items.forEach((el) => io.observe(el));
  };
  initReveal();
  document.addEventListener('astro:page-load', initReveal);
</script>
