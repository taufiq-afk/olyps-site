---
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import PageShell from '../../../components/PageShell.astro';
import Avatar from '../../../components/Avatar.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import Related from '../../../components/Related.astro';
import { entrySlug, getLocalized, getRelated } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import { siteLangs, type Lang } from '../../../site.config';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of siteLangs) {
    for (const entry of await getLocalized('people', lang)) {
      paths.push({ params: { lang, slug: entrySlug(entry.id) }, props: { entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const related = await getRelated('people', entry.data.translationKey, lang);
---
<PageShell lang={lang} current="people" title={entry.data.name}>
  <a class="back-link" href={`${base}/${lang}/people/`}><ArrowLeft size={18} aria-hidden="true" />{t('people.back')}</a>
  <article class="profile">
    <Avatar name={entry.data.name} photo={entry.data.photo} large />
    <div class="profile__main">
      <p class="profile__role">{entry.data.role}{entry.data.placeholder && <Fragment> <PlaceholderBadge lang={lang} /></Fragment>}</p>
      <p class="profile__bio">{entry.data.bio}</p>
      {entry.data.affiliations.length > 0 && (
        <section class="profile__block" data-affiliations>
          <h2>{t('people.affiliations')}</h2>
          <ul class="affiliations">{entry.data.affiliations.map((item) => <li>{item}</li>)}</ul>
        </section>
      )}
      {entry.data.links.length > 0 && (
        <section class="profile__block">
          <h2>{t('people.links')}</h2>
          <ul class="profile__links">
            {entry.data.links.map((link) => (
              <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<ExternalLink size={14} aria-hidden="true" /><span class="sr-only"> ({t('a11y.newTab')})</span></a></li>
            ))}
          </ul>
        </section>
      )}
      {entry.data.skills.length > 0 && (
        <section class="profile__block">
          <h2>{t('people.skills')}</h2>
          <ul class="skills">{entry.data.skills.map((skill) => <li class="chip chip--plain">{skill}</li>)}</ul>
        </section>
      )}
      <Related lang={lang} items={related} />
    </div>
  </article>
</PageShell>

<style>
  .profile { display: grid; gap: var(--space-5); align-items: start; }
  @media (min-width: 48rem) { .profile { grid-template-columns: auto minmax(0, 1fr); gap: var(--space-6); } }
  .profile__role { font-size: var(--text-lead); font-weight: 600; }
  /* Bio dan afiliasi memakai token tipografi yang sama. Label AFFILIATIONS tetap menjadi penanda. */
  .profile__bio, .affiliations { font-size: var(--text-body); font-weight: 400; line-height: 1.6; color: var(--text-muted); max-width: var(--measure); }
  .profile__bio { margin-top: var(--space-3); }
  .profile__block { margin-top: var(--space-5); }
  .profile__block h2 { font-size: var(--text-small); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-2); }
  .affiliations { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .profile__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .profile__links a { display: inline-flex; align-items: center; gap: var(--space-1); min-height: var(--tap); color: var(--accent); }
  .skills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
</style>
