---
import PageShell from '../../../components/PageShell.astro';
import Avatar from '../../../components/Avatar.astro';
import Card from '../../../components/Card.astro';
import { entrySlug, getLocalized, getPage } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import { siteLangs, type Lang } from '../../../site.config';

export function getStaticPaths() {
  return siteLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const people = await getLocalized('people', lang);
const page = await getPage('people', lang);
// Satu grid kompak, kartu sama untuk semua. Afiliasi tidak ditampilkan di kartu, hanya di halaman profil.
---
<PageShell lang={lang} current="people" title={page.title} lead={page.lead}>
  {people.length === 0 ? (
    <div class="card">{page.emptyTitle && <h2>{page.emptyTitle}</h2>}{page.emptyBody && <p>{page.emptyBody}</p>}</div>
  ) : (
    <div class="entry-grid">
      {people.map((person) => (
        <Card href={`${base}/${lang}/people/${entrySlug(person.id)}/`} title={person.data.name}>
          <Avatar slot="media" name={person.data.name} photo={person.data.photo} />
          <p slot="meta" class="entry-card__role">{person.data.role}</p>
        </Card>
      ))}
    </div>
  )}
</PageShell>

<style is:global>
  .entry-card__role { margin: 0; font-size: var(--text-small); color: var(--text-muted); }
</style>
