---
import { ExternalLink, Mail } from '@lucide/astro';
import PageShell from '../../components/PageShell.astro';
import { getContact, getNavLabel } from '../../i18n/content';
import { useTranslations } from '../../i18n/utils';
import type { UiKey } from '../../i18n/ui';
import { siteLangs, type Lang } from '../../site.config';

export function getStaticPaths() {
  return siteLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
// Sumber tunggal: src/content/contact/<lang>/contact.md (dipakai juga oleh footer).
const contact = await getContact(lang);
---
<PageShell lang={lang} current="contact" title={await getNavLabel('contact', lang)} lead={contact.lead} banner="50% 92%" split>
  <div class="contact-list">
    {contact.links.map((link) => (
      <a class="card card--md card--link" data-glow href={link.url} target="_blank" rel="noopener noreferrer">
        <h2>{link.label}</h2>
        <p>{link.url.replace(/^https?:\/\//, '')}</p>
        <span class="btn btn--primary">{t(`contact.cta.${link.kind}` as UiKey)}<ExternalLink size={18} aria-hidden="true" /><span class="sr-only"> ({t('a11y.newTab')})</span></span>
      </a>
    ))}
    {contact.email && (
      <a class="card card--md card--link" data-glow href={`mailto:${contact.email}`}>
        <h2>Email</h2>
        <p>{contact.email}</p>
        <span class="btn btn--primary">{contact.email}<Mail size={18} aria-hidden="true" /></span>
      </a>
    )}
  </div>
</PageShell>

<style>
  .contact-list { display: grid; gap: var(--space-4); }
</style>
