---
import StatusLine from '../../../components/StatusLine.astro';
import { ArrowUpRight, Folder } from '@lucide/astro';
import PageShell from '../../../components/PageShell.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import { entrySlug, getLocalized, getPage } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import type { UiKey } from '../../../i18n/ui';
import { siteLangs, type Lang } from '../../../site.config';

export function getStaticPaths() {
  return siteLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = await getLocalized('projects', lang);
const page = await getPage('projects', lang);
---
<PageShell lang={lang} current="projects" title={page.title} lead={page.lead} banner="50% 52%">
  {items.length === 0 ? (
    <div class="card empty">{page.emptyTitle && <h2>{page.emptyTitle}</h2>}{page.emptyBody && <p>{page.emptyBody}</p>}</div>
  ) : (
    <div class="card-grid">
      {items.map((entry) => (
        <a class="card card--md card--link" data-glow href={`${base}/${lang}/projects/${entrySlug(entry.id)}/`}>
          <span class="icon-tile"><Folder size={26} aria-hidden="true" /></span>
          <h2>{entry.data.title}</h2>
          <StatusLine lang={lang} status={entry.data.status} startDate={entry.data.startDate} endDate={entry.data.endDate} />
          <p>{entry.data.summary}</p>
          {entry.data.placeholder && <PlaceholderBadge lang={lang} />}
          <ArrowUpRight class="card__arrow" size={22} aria-hidden="true" />
        </a>
      ))}
    </div>
  )}
</PageShell>

<style>
  .empty { max-width: 36rem; }
</style>
