---
import { render } from 'astro:content';
import PageShell from '../../../components/PageShell.astro';
import DetailPage from '../../../components/DetailPage.astro';
import MediaSlot from '../../../components/MediaSlot.astro';
import { entrySlug, getLocalized, getRelated } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/utils';
import { siteLangs, type Lang } from '../../../site.config';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of siteLangs) {
    for (const entry of await getLocalized('projects', lang)) {
      paths.push({ params: { lang, slug: entrySlug(entry.id) }, props: { entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(entry);
const all = await getRelated('projects', entry.data.translationKey, lang);
// Orang yang terkait tampil sebagai anggota, sisanya sebagai item terkait.
const members = all.filter((r) => r.kind === 'people');
const related = all.filter((r) => r.kind !== 'people');
const hasMedia = !!(entry.data.image || entry.data.mediaVideo);
---
<PageShell lang={lang} current="projects" title={entry.data.title} banner="50% 52%">
  <DetailPage
    lang={lang}
    backHref={`${base}/${lang}/projects/`}
    backLabel={t('projects.back')}
    summary={entry.data.summary}
    placeholder={entry.data.placeholder}
    status={entry.data.status}
    startDate={entry.data.startDate}
    endDate={entry.data.endDate}
    leadsTo={entry.data.leadsTo}
    leadsToUrl={entry.data.leadsToUrl}
    people={members}
    peopleLabel={t('projects.members')}
    related={related}
  >
    <Content />
    {hasMedia && (
      <MediaSlot slot="media" lang={lang} image={entry.data.image} alt={entry.data.imageAlt} caption={entry.data.imageCaption} video={entry.data.mediaVideo} captions={entry.data.mediaCaptions} />
    )}
  </DetailPage>
</PageShell>
