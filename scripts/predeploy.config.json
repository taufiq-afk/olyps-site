  "secretFiles": ["^\\.env($|\\.(?!example$))", "\\.pem$", "\\.key$", "\\.p12$", "(^|/)id_(rsa|dsa|ecdsa|ed25519)", "(^|/)credentials.*\\.json$"],
  "secretContent": [
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "ghp_[A-Za-z0-9]{30,}",
    "github_pat_[A-Za-z0-9_]{30,}",
    "sk-[A-Za-z0-9]{24,}",
    "(api[_-]?key|secret|token|password)\\s*[:=]\\s*['\"][^'\"]{12,}['\"]"
  ]
}
